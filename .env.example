# QueryMind local configuration.
# Copy this file to .env and fill real values. Do not commit .env.

# PostgreSQL demo connection
QUERYMIND_PG_HOST=localhost
QUERYMIND_PG_PORT=5432
QUERYMIND_PG_DATABASE=postgres
QUERYMIND_PG_USER=root
QUERYMIND_PG_PASSWORD=123456
QUERYMIND_PG_CONNECT_TIMEOUT=5

# Optional LLM support.
# LLM can generate QueryPlan and insight, but SQL is still generated by the semantic layer.
QUERYMIND_LLM_ENABLED=true
QUERYMIND_LLM_PROVIDER=deepseek
QUERYMIND_LLM_BASE_URL=https://api.deepseek.com
QUERYMIND_LLM_MODEL=deepseek-chat
QUERYMIND_LLM_API_KEY=replace_with_your_api_key
QUERYMIND_LLM_MAX_TOKENS=2048
QUERYMIND_LLM_TIMEOUT=60
QUERYMIND_LLM_MAX_RETRIES=2
